{
  "name": "@licenseflow/cli",
  "version": "1.0.0",
  "description": "LicenseFlow CLI - Manage licenses, activations, and fingerprints from the command line",
  "main": "dist/index.js",
  "bin": {
    "licenseflow": "dist/index.js",
    "lf": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "pkg:win": "pkg dist/index.js --targets node18-win-x64 --output bin/licenseflow-win.exe",
    "pkg:mac": "pkg dist/index.js --targets node18-macos-x64 --output bin/licenseflow-macos",
    "pkg:linux": "pkg dist/index.js --targets node18-linux-x64 --output bin/licenseflow-linux",
    "pkg:all": "npm run build && npm run pkg:win && npm run pkg:mac && npm run pkg:linux",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "keywords": [
    "licenseflow",
    "license",
    "cli",
    "activation",
    "fingerprint",
    "hardware",
    "ci-cd"
  ],
  "author": "LicenseFlow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/licenseflow/licenseflow-cli"
  },
  "homepage": "https://licenseflow.dev",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "conf": "^12.0.0",
    "ora": "^8.0.1",
    "systeminformation": "^5.21.0",
    "table": "^6.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "pkg": "^5.8.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
